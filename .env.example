MQTT_BROKER_URL=tls://localhost:8883
MQTT_USERNAME=iot
MQTT_PASSWORD=changeme
# CA, которым подписан сертификат брокера (см. deploy/mosquitto/gen-dev-certs.sh) —
# самоподписанный, системный пул доверенных корней его не примет.
MQTT_CA_CERT_FILE=./deploy/mosquitto/certs/ca.crt

DATABASE_URL=postgres://iot:changeme@localhost:5432/iot?sslmode=disable

HTTP_ADDR=:8080

# Алерты (Этап 7). Если TELEGRAM_BOT_TOKEN или TELEGRAM_CHAT_ID пустые —
# фоновая проверка не запускается. Токен — от @BotFather, chat_id — от @userinfobot
# или из ответа getUpdates после первого сообщения боту.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Как часто проверять показания на offline/пороги и через сколько времени без
# новых показаний метрика считается offline — формат time.ParseDuration.
ALERT_CHECK_INTERVAL=1m
ALERT_OFFLINE_AFTER=3m
# Пороги по метрикам вида "metric:min:max,metric2:min:max", граница может быть
# пустой (не ограничена). Пример: "temperature::30,humidity:20:80"
ALERT_THRESHOLDS=
