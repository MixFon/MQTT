# Шаблон переменных окружения для telegram-proxy (см. CLAUDE.md, раздел про
# обход блокировки Telegram через OpenVPN).
#
# Внимание: этот файл живёт НЕ на iot-backend VPS, а на машине с OpenVPN-
# сервером — она должна иметь реальный сетевой доступ к api.telegram.org.
#
# На сервере: скопировать в /etc/telegram-proxy.env, заполнить, ограничить доступ:
#   sudo chown root:telegram-proxy /etc/telegram-proxy.env
#   sudo chmod 640 /etc/telegram-proxy.env

# Слушать только на внутреннем адресе OpenVPN-интерфейса (обычно tun0), а не
# на внешнем/публичном — иначе прокси будет доступен всем в интернете.
# Реальный адрес интерфейса: ip addr show tun0
PROXY_LISTEN_ADDR=10.8.0.1:3128

# Через запятую, без пробелов. Порт всегда 443, это не настраивается (см.
# cmd/telegram-proxy/proxy.go, hostAllowed). Если не задано — по умолчанию
# только api.telegram.org.
PROXY_ALLOWED_HOSTS=api.telegram.org

# Общий секрет. В той же VPN-сети есть другие клиенты (не только
# iot-backend), поэтому токен обязателен — без него бинарник не запустится.
# Должен совпадать с паролем в TELEGRAM_PROXY_URL на стороне iot-backend:
#   TELEGRAM_PROXY_URL=http://<любой-логин>:<этот токен>@10.8.0.1:3128
PROXY_TOKEN=changeme
