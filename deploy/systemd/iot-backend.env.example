# Шаблон переменных окружения для systemd-юнита (Этап 6).
#
# На VPS: скопировать в /etc/iot-backend.env, заполнить реальными значениями,
# затем ограничить доступ:
#   sudo chown root:iot-backend /etc/iot-backend.env
#   sudo chmod 640 /etc/iot-backend.env
#
# В отличие от .env.example в корне репозитория (для локальной разработки
# через docker-compose), этот файл живёт только на сервере — сам он
# с реальными секретами в репозиторий не попадает.

MQTT_BROKER_URL=tls://mrmixfon.ru:8883
MQTT_USERNAME=iot
MQTT_PASSWORD=changeme
# CA, которым подписан сертификат брокера (см. VPS_DEPLOY.md, раздел 3) —
# самоподписанный, системный пул доверенных корней его не примет.
MQTT_CA_CERT_FILE=/etc/mosquitto/certs/ca.crt

DATABASE_URL=postgres://iot:changeme@localhost:5432/iot?sslmode=disable

# Слушаем только localhost — наружу смотрит Caddy (см. deploy/Caddyfile),
# сам Go-процесс наружу не торчит.
HTTP_ADDR=127.0.0.1:8080

# Алерты (Этап 7). Если TELEGRAM_BOT_TOKEN или TELEGRAM_CHAT_ID пустые —
# фоновая проверка не запускается.
TELEGRAM_BOT_TOKEN=changeme
TELEGRAM_CHAT_ID=changeme
ALERT_CHECK_INTERVAL=1m
ALERT_OFFLINE_AFTER=3m
ALERT_THRESHOLDS=

# api.telegram.org недоступен с этого VPS напрямую (блокировка в РФ, см.
# VPS_NOTES.md) — запросы идут через прокси на OpenVPN-сервере
# (cmd/telegram-proxy, deploy/telegram-proxy/). Логин произвольный, пароль —
# токен из PROXY_TOKEN на стороне прокси. Пусто — запросы идут напрямую (не
# заработает пока сервер в РФ).
TELEGRAM_PROXY_URL=http://iot:changeme@10.8.0.1:3128
